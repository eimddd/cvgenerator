اهالي شارع ","font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14,"rtl":true},{"font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14,"field":"f5","blank":"……………"},{"t":"، فيما يخص المهن المضرة والمزعجة والتي تؤدي مزاولتها إلى الإزعاج وانعدام الطمأنينة والسكينة لدى سكان هذا الشارع من جراء الضوضاء والأدخنة المتصاعدة فأرجو من سيادتكم التدخل للتوقيف هذا العمل ولكم التقدير","font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14,"rtl":true},{"t":".","font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14}],"mark":{"size":14,"sizeCs":14,"font":"Calibri","fontCs":"Calibri"}},{"type":"p","after":0,"line":360,"lineRule":"auto","before":0,"jc":"both","bidi":true,"indFirst":35.4,"runs":[{"t":"فلقد اكد عدد من سكان شارع ","font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14,"rtl":true},{"font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14,"field":"f6","blank":"…………….."},{"t":" بان المهن الملوثة حولت حياتهم إلى عذاب، مؤكدين بأن حي ","font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14,"rtl":true},{"font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14,"field":"f7","blank":"…………."},{"font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14,"t":" "},{"t":"تحول إلى حي صناعي بامتياز، وانه في غياب المراقبة وممارسة الدور المنوط بالمسؤولين، وفي ظل تجاوزات عديدة، صار هذا الحي مرتعا لأصحاب كل حرفة ممنوعة وسط أحياء آهلة بالسكان كالحدادة واللحامة وغيرها من المهن المضرة والمزعجة والتي تؤدي مزاولتها إلى خلق الإزعاج وانعدام الطمأنينة والسكينة جراء الضوضاء والأدخنة المتصاعدة التي تدخل عبر الأبواب والنوافذ، وما يترتب عنها من أوساخ بداخل البيوت، ناهيك عما يترتب عنها من أضرار وأمراض بصحة الساكنة كالحساسية والضيقة وارتفاع الضغط الدموي، وهذه الحالة دفعت بالسكان إلى التفكير في بيع منازلهم والسكن بعيدا، خصوصا وأن فيهم المرضى والشيوخ والأطفال وربات البيوت وأكد المتضررون الذين وصفوا حالتهم بالمزرية، بأنهم لن يستطيعوا وصف حجم الخسائر النفسية والبدنية والبيئية التي نجمت عن مزاولة هذه المهنة وسط حينا وأزقتنا، معتبرين أنفسهم مواطنين مثل من يسكن الأحياء الراقية ولهم الحق في العيش في سكينة وطمأنينة وراحة بال ولهم الحق في سماع أصوات العصافير عوض أصوات (السودور) التي لا تنقطع اليوم كله والأسبوع كله، أصوات اعتبرها المتضررون لا يتحملها سمع بشر ولا عقله، ولو أن أحدا من المسؤولين الذي سمح بمزاولة هذه المهن زار هذا الحي لتفقده، لما استطاع أن يتحمل هذه الأصوات ولو لخمس دقائق فكيف بنا ونحن نسمعها طوال اليوم .","font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14,"rtl":true}],"mark":{"size":14,"sizeCs":14,"font":"Calibri","fontCs":"Calibri"}},{"type":"p","after":0,"line":360,"lineRule":"auto","before":0,"jc":"both","bidi":true,"runs":[],"mark":{"size":14,"sizeCs":14,"font":"Calibri","fontCs":"Calibri"}},{"type":"p","after":0,"line":360,"lineRule":"auto","jc":"center","bidi":true,"indStart":-0.05,"runs":[{"t":"وفي انتظار ذلك تقبلوا مني اسمى عبارات التقدير والاحترام والسلام .","font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14,"b":true,"rtl":true}],"mark":{"size":14,"sizeCs":14,"font":"Calibri","fontCs":"Calibri"}},{"type":"p","after":0,"line":360,"lineRule":"auto","jc":"both","bidi":true,"runs":[],"mark":{"size":14,"sizeCs":14,"font":"Calibri","fontCs":"Calibri"}},{"type":"p","after":0,"line":240,"lineRule":"auto","jc":"center","bidi":true,"runs":[],"mark":{"size":18,"sizeCs":18,"font":"Calibri","fontCs":"Calibri"}},{"type":"p","after":0,"line":240,"lineRule":"auto","jc":"center","bidi":true,"runs":[{"t":"توقيعات ساكنة ","font":"Calibri","fontCs":"Calibri","size":16,"sizeCs":16,"bCs":true,"rtl":true},{"font":"Calibri","fontCs":"Calibri","size":16,"sizeCs":16,"bCs":true,"rtl":true,"field":"f8","blank":"..........................."},{"t":"، حول شكاية رفع الضرر المتمثل ","font":"Calibri","fontCs":"Calibri","size":16,"sizeCs":16,"bCs":true,"rtl":true},{"t":"في المهن المضرة والمزعجة","font":"Calibri","fontCs":"Calibri","size":14,"sizeCs":14,"bCs":true,"rtl":true}],"mark":{"size":14,"sizeCs":14,"font":"Calibri","fontCs":"Calibri"}},{"type":"p","after":0,"line":240,"lineRule":"auto","jc":"center","bidi":true,"runs":[],"mark":{"size":16,"sizeCs":